// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  DIRECTEUR
  CAISSE
  // Compte technique unique, jamais utilisé pour se connecter : sert
  // uniquement à tracer "qui a enregistré ce paiement" quand un paiement
  // en ligne CinetPay est confirmé automatiquement par le webhook, sans
  // caissier humain impliqué.
  SYSTEME
}

enum MethodePaiement {
  ESPECES
  MOBILE_MONEY
}

enum StatutTransaction {
  EN_ATTENTE
  REUSSI
  ECHEC
}

// Une école cliente de la plateforme. Tout est rattaché à une École
// pour que la plateforme supporte plusieurs écoles dès le départ.
model Ecole {
  id        String   @id @default(cuid())
  nom       String
  adresse   String?
  telephone String?
  createdAt DateTime @default(now())

  // Intégration paiement en ligne (CinetPay). Chaque école connecte son
  // propre compte marchand : l'argent va directement chez elle, EcolaPay
  // ne touche jamais les fonds. Optionnel, désactivé par défaut.
  paiementEnLigneActif Boolean @default(false)
  cinetpayApiKey       String?
  cinetpaySiteId       String?
  // Pourcentage de "frais de confort" répercuté au parent lors d'un
  // paiement en ligne (couvre le frais CinetPay, à la charge du parent
  // et non de l'école ni d'EcolaPay). Ex : 2 = 2%. Contrôlé uniquement
  // par le Super Admin EcolaPay, pas par l'école elle-même.
  fraisConfortPourcent Int?

  utilisateurs         Utilisateur[]
  niveaux              Niveau[]
  tranches             Tranche[]
  eleves               Eleve[]
  transactionsPaiement TransactionPaiement[]

  @@map("ecoles")
}

// Un compte directeur, caisse, ou super admin EcolaPay. Un directeur/caisse
// est rattaché à une seule école ; un super admin n'est rattaché à aucune
// école (ecoleId nul), il supervise toute la plateforme.
model Utilisateur {
  id         String   @id @default(cuid())
  email      String   @unique
  motDePasse String
  nom        String
  role       Role
  createdAt  DateTime @default(now())

  ecoleId String?
  ecole   Ecole?  @relation(fields: [ecoleId], references: [id])

  paiementsEnregistres Paiement[]

  @@map("utilisateurs")
}

// Un niveau/classe défini par une école (ex: "6ème", "Terminale D").
// Chaque école définit ses propres niveaux et leur tarification.
model Niveau {
  id      String @id @default(cuid())
  nom     String
  ordre   Int    @default(0)

  ecoleId String
  ecole   Ecole  @relation(fields: [ecoleId], references: [id])

  eleves Eleve[]
  tarifs TarifTranche[]

  @@unique([ecoleId, nom])
  @@map("niveaux")
}

// Un élève, rattaché à une école et à un niveau.
model Eleve {
  id              String   @id @default(cuid())
  nom             String
  prenom          String
  parentNom       String
  // Numéro WhatsApp du parent principal (celui qui paie) — au format
  // international, ex: "+2250700000000". C'est le champ central du projet.
  parentTelephone String
  createdAt       DateTime @default(now())

  ecoleId String
  ecole   Ecole  @relation(fields: [ecoleId], references: [id])

  niveauId String
  niveau   Niveau @relation(fields: [niveauId], references: [id])

  paiements            Paiement[]
  transactionsPaiement TransactionPaiement[]

  @@map("eleves")
}

// Une échéance de scolarité définie par une école (ex: "Inscription",
// "Trimestre 1"). Le montant n'est PAS stocké ici : il dépend du niveau,
// voir TarifTranche.
model Tranche {
  id           String    @id @default(cuid())
  nom          String
  ordre        Int       @default(0)
  dateEcheance DateTime?

  ecoleId String
  ecole   Ecole  @relation(fields: [ecoleId], references: [id])

  tarifs               TarifTranche[]
  paiements            Paiement[]
  transactionsPaiement TransactionPaiement[]

  @@unique([ecoleId, nom])
  @@map("tranches")
}

// La grille tarifaire : combien coûte une Tranche donnée pour un Niveau
// donné. Permet à chaque école d'avoir des prix différents par trimestre
// et par classe, sans rien coder en dur.
model TarifTranche {
  id      String @id @default(cuid())
  montant Int // en FCFA, toujours un nombre entier (pas de centimes)

  trancheId String
  tranche   Tranche @relation(fields: [trancheId], references: [id])

  niveauId String
  niveau   Niveau  @relation(fields: [niveauId], references: [id])

  @@unique([trancheId, niveauId])
  @@map("tarifs_tranches")
}

// Un encaissement réel. Le solde d'un élève sur une tranche =
// TarifTranche.montant (pour son niveau) − somme de ses Paiements sur
// cette tranche.
model Paiement {
  id      Int             @id @default(autoincrement())
  montant Int
  methode MethodePaiement
  date    DateTime        @default(now())

  // Rempli quand le reçu WhatsApp a bien été envoyé (pour éviter les
  // doublons et pouvoir vérifier/relancer les envois ratés).
  recuEnvoyeAt DateTime?

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id])

  trancheId String
  tranche   Tranche @relation(fields: [trancheId], references: [id])

  enregistreParId String
  enregistrePar   Utilisateur @relation(fields: [enregistreParId], references: [id])

  // Présent seulement si ce paiement a été créé automatiquement suite à un
  // paiement en ligne CinetPay confirmé par webhook (sinon paiement en
  // espèces/mobile money enregistré manuellement par la Caisse).
  transaction TransactionPaiement?

  @@map("paiements")
}

// Une tentative de paiement en ligne via CinetPay, créée dès que le lien de
// paiement est généré. Le statut ne passe à REUSSI/ECHEC qu'après
// confirmation par le webhook CinetPay + vérification via l'API officielle
// (jamais sur la seule foi du retour navigateur du parent) — voir doc
// CinetPay "checkout/notification". C'est cette table qui fait le pont
// entre le transaction_id envoyé à CinetPay et l'élève/la tranche concernés.
model TransactionPaiement {
  id            String            @id @default(cuid())
  transactionId String            @unique
  montantDu     Int // solde dû au moment de la génération du lien
  montantFrais  Int // frais de confort calculé, à la charge du parent
  montantTotal  Int // montantDu + montantFrais, réellement débité en ligne
  statut        StatutTransaction @default(EN_ATTENTE)
  createdAt     DateTime          @default(now())
  confirmeAt    DateTime?

  ecoleId String
  ecole   Ecole  @relation(fields: [ecoleId], references: [id])

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id])

  trancheId String
  tranche   Tranche @relation(fields: [trancheId], references: [id])

  // Rempli une fois le paiement confirmé et le Paiement créé automatiquement.
  paiementId Int?      @unique
  paiement   Paiement? @relation(fields: [paiementId], references: [id])

  @@map("transactions_paiement")
}
